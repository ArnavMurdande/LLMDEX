	partition DimLeaderAA = calculated
		mode: import
		source =
				VAR LatestDate = CALCULATE ( MAX ( 'FactAA'[snapshot_date] ), ALL ( 'FactAA' ) )
				VAR Base =
				    FILTER (
				        ALL ( 'FactAA' ),
				        'FactAA'[snapshot_date] = LatestDate
				            && 'FactAA'[is_family_representative] = TRUE ()
				            && NOT ISBLANK ( 'FactAA'[llmdex_performance_rank] )
				    )
				VAR Ranked =
				    ADDCOLUMNS (
				        Base,
				        "__overall_rank", RANKX ( Base, 'FactAA'[llmdex_performance_rank], , ASC, DENSE ),
				        "__value_display_rank", IF ( NOT ISBLANK ( 'FactAA'[llmdex_value_rank] ), RANKX ( FILTER ( Base, NOT ISBLANK ( 'FactAA'[llmdex_value_rank] ) ), 'FactAA'[llmdex_value_rank], , ASC, DENSE ) ),
				        "__efficiency_display_rank", IF ( NOT ISBLANK ( 'FactAA'[llmdex_efficiency_rank] ), RANKX ( FILTER ( Base, NOT ISBLANK ( 'FactAA'[llmdex_efficiency_rank] ) ), 'FactAA'[llmdex_efficiency_rank], , ASC, DENSE ) )
				    )
				RETURN
				    SELECTCOLUMNS (
				        Ranked,
				        "model_key", 'FactAA'[model_key],
				        "family_id", 'FactAA'[family_id],
				        "model_name", 'FactAA'[canonical_name],
				        "provider_id", 'FactAA'[provider_id],
				        "provider_name", COALESCE ( LOOKUPVALUE ( 'DimProvider'[provider_name], 'DimProvider'[provider_id], 'FactAA'[provider_id] ), 'FactAA'[provider] ),
				        "logo_url", LOOKUPVALUE ( 'DimProvider'[logo_url], 'DimProvider'[provider_id], 'FactAA'[provider_id] ),
				        "availability_class", 'FactAA'[availability_class],
				        "composite_index", 'FactAA'[llmdex_composite_index],
				        "performance_score", 'FactAA'[llmdex_adjusted_performance],
				        "performance_rank", 'FactAA'[llmdex_performance_rank],
				        "value_rank", 'FactAA'[llmdex_value_rank],
				        "efficiency_rank", 'FactAA'[llmdex_efficiency_rank],
				        "blended_cost", 'FactAA'[aa_blended_cost_usd_per_1m],
				        "output_speed", 'FactAA'[aa_tokens_per_second],
				        "intelligence", 'FactAA'[aa_intelligence_score],
				        "overall_rank", [__overall_rank],
				        "value_display_rank", [__value_display_rank],
				        "efficiency_display_rank", [__efficiency_display_rank]
				    )

	annotation PBI_Id = 1c65332940a0434d86f57dd9d474a198

