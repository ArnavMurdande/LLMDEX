	partition DimModelAA = calculated
		mode: import
		source =
				
				VAR ModelKeys =
				    FILTER (
				        DISTINCT (
				            SELECTCOLUMNS (
				                'FactAA',
				                "model_key", 'FactAA'[model_key]
				            )
				        ),
				        NOT ISBLANK ( [model_key] )
				            && [model_key] <> ""
				    )
				RETURN
				    ADDCOLUMNS (
				        ModelKeys,
				
				        "model_name",
				            VAR CurrentModel = [model_key]
				            RETURN
				                MAXX (
				                    FILTER (
				                        ALL ( 'FactAA' ),
				                        'FactAA'[model_key] = CurrentModel
				                    ),
				                    'FactAA'[canonical_name]
				                ),
				
				        "family_id",
				            VAR CurrentModel = [model_key]
				            RETURN
				                MAXX (
				                    FILTER (
				                        ALL ( 'FactAA' ),
				                        'FactAA'[model_key] = CurrentModel
				                    ),
				                    'FactAA'[family_id]
				                ),
				
				        "variant_id",
				            VAR CurrentModel = [model_key]
				            RETURN
				                MAXX (
				                    FILTER (
				                        ALL ( 'FactAA' ),
				                        'FactAA'[model_key] = CurrentModel
				                    ),
				                    'FactAA'[variant_id]
				                ),
				
				        "provider_id",
				            VAR CurrentModel = [model_key]
				            RETURN
				                MAXX (
				                    FILTER ( ALL ( 'FactAA' ), 'FactAA'[model_key] = CurrentModel ),
				                    'FactAA'[provider_id]
				                ),
				
				        "provider",
				            VAR CurrentModel = [model_key]
				            RETURN
				                MAXX (
				                    FILTER (
				                        ALL ( 'FactAA' ),
				                        'FactAA'[model_key] = CurrentModel
				                    ),
				                    'FactAA'[provider]
				                ),
				
				        "availability_class",
				            VAR CurrentModel = [model_key]
				            RETURN
				                MAXX (
				                    FILTER (
				                        ALL ( 'FactAA' ),
				                        'FactAA'[model_key] = CurrentModel
				                    ),
				                    'FactAA'[availability_class]
				                )
				    )

	annotation PBI_Id = 8cfc7f5515254703aeac69db79f50afb

