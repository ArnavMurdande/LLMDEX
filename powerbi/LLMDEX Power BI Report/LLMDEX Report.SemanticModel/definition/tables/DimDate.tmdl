	column 'Year Month Sort'
		formatString: 0
		lineageTag: 147cee3b-8b04-4215-a015-01fe2ef6fba5
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year Month Sort]

		annotation SummarizationSetBy = Automatic

	partition DimDate = calculated
		mode: import
		source =
				
				VAR AllDates =
				    FILTER (
				        DISTINCT (
				            UNION (
				                SELECTCOLUMNS (
				                    'FactAA',
				                    "Date", 'FactAA'[snapshot_date]
				                ),
				                SELECTCOLUMNS (
				                    'FactLLMStats',
				                    "Date", 'FactLLMStats'[snapshot_date]
				                ),
				                SELECTCOLUMNS (
				                    'FactHistory',
				                    "Date", 'FactHistory'[observation_date]
				                )
				            )
				        ),
				        NOT ISBLANK ( [Date] )
				    )
				
				VAR MinimumDate =
				    MINX ( AllDates, [Date] )
				
				VAR MaximumDate =
				    MAXX ( AllDates, [Date] )
				
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( MinimumDate, MaximumDate ),
				        "Year", YEAR ( [Date] ),
				        "Month Number", MONTH ( [Date] ),
				        "Month Name", FORMAT ( [Date], "MMM" ),
				        "Quarter", "Q" & FORMAT ( [Date], "Q" ),
				        "Year Month", FORMAT ( [Date], "YYYY-MM" ),
				        "Year Month Sort",
				            YEAR ( [Date] ) * 100
				                + MONTH ( [Date] )
				    )

	annotation PBI_Id = b6e935483f8242bda20400bc529d9eae

